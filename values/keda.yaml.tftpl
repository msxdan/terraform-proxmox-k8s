# CRD management — keep CRDs on uninstall to prevent data loss
crds:
  install: true

operator:
  replicaCount: ${operator_replicas}

metricsServer:
  replicaCount: ${metrics_server_replicas}

webhooks:
  replicaCount: ${webhooks_replicas}

%{ if prometheus_service_monitor ~}
prometheus:
  operator:
    enabled: true
    serviceMonitor:
      enabled: true
  metricServer:
    enabled: true
    serviceMonitor:
      enabled: true
  webhooks:
    enabled: true
    serviceMonitor:
      enabled: true
%{ endif ~}

%{ if cert_manager_certificates ~}
certificates:
  autoGenerated: false
  certManager:
    enabled: true
    generateCA: true
%{ endif ~}
