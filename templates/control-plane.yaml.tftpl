machine:
  install:
    image: factory.talos.dev/${platform}-installer/${schematic_id}:${talos_config.image.version}
%{ if length(talos_config.kernel_args) > 0 ~}
    extraKernelArgs:
%{ for kernel_arg in talos_config.kernel_args ~}
    - ${kernel_arg}
%{ endfor ~}
%{ endif ~}
  network:
%{ if hostname != "" ~}
    hostname: ${hostname}
%{ endif ~}
%{ if gateway != null || virtual_ip != null ~}
    interfaces:
%{ if mac_address != "" ~}
    - deviceSelector:
        hardwareAddr: "${lower(mac_address)}"
%{ else ~}
    - interface: ${interface_name}
%{ endif ~}
      dhcp: ${gateway == null}
%{ if virtual_ip != null ~}
      vip:
        ip: ${virtual_ip}
%{ endif ~}
%{ endif ~}
%{ if length(tuning.sysctls) > 0 ~}
  sysctls:
%{ for key, value in tuning.sysctls ~}
    ${key}: "${value}"
%{ endfor ~}
%{ endif ~}
  kubelet:
%{ if tuning.seccomp_default ~}
    defaultRuntimeSeccompProfileEnabled: true
%{ endif ~}
%{ if length(tuning.allowed_unsafe_sysctls) > 0 ~}
    extraArgs:
      allowed-unsafe-sysctls: "${join(",", tuning.allowed_unsafe_sysctls)}"
%{ endif ~}
    extraConfig:
      shutdownGracePeriod: ${tuning.shutdown_grace_period}
      imageGCHighThresholdPercent: ${tuning.image_gc_high}
      imageGCLowThresholdPercent: ${tuning.image_gc_low}
%{ if tuning.server_tls_bootstrap ~}
      serverTLSBootstrap: true
%{ endif ~}
cluster:
  allowSchedulingOnControlPlanes: ${allow_scheduling_on_control_planes}
  adminKubeconfig:
    certLifetime: ${cluster_tuning.kubeconfig_cert_lifetime}
  apiServer:
    resources:
      requests:
        cpu: ${cluster_tuning.api_server_cpu_request}
        memory: ${cluster_tuning.api_server_memory_request}
  etcd:
    extraArgs:
      election-timeout: "${cluster_tuning.etcd_election_timeout}"
      heartbeat-interval: "${cluster_tuning.etcd_heartbeat_interval}"
  network:
    cni:
      name: none
  proxy:
    disabled: true
%{ if length(extra_manifests) > 0 ~}
  extraManifests:
%{ for url in extra_manifests ~}
  - ${url}
%{ endfor ~}
%{ endif ~}
