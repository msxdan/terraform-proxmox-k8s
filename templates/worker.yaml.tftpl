machine:
  install:
    image: factory.talos.dev/${platform}-installer/${schematic_id}:${talos_config.image.version}
%{ if length(talos_config.kernel_args) > 0 ~}
    extraKernelArgs:
%{ for kernel_arg in talos_config.kernel_args ~}
    - ${kernel_arg}
%{ endfor ~}
%{ endif ~}
  network:
%{ if hostname != "" ~}
    hostname: ${hostname}
%{ endif ~}
%{ if gateway != null ~}
    interfaces:
%{ if mac_address != "" ~}
    - deviceSelector:
        hardwareAddr: "${lower(mac_address)}"
%{ else ~}
    - interface: ${interface_name}
%{ endif ~}
      dhcp: false
%{ endif ~}
%{ if length(machine_tuning.sysctls) > 0 ~}
  sysctls:
%{ for key, value in machine_tuning.sysctls ~}
    ${key}: "${value}"
%{ endfor ~}
%{ endif ~}
  kubelet:
%{ if machine_tuning.seccomp_default ~}
    defaultRuntimeSeccompProfileEnabled: true
%{ endif ~}
    extraConfig:
      shutdownGracePeriod: ${machine_tuning.shutdown_grace_period}
      shutdownGracePeriodCriticalPods: ${machine_tuning.shutdown_grace_period}
      imageGCHighThresholdPercent: ${machine_tuning.image_gc_high}
      imageGCLowThresholdPercent: ${machine_tuning.image_gc_low}
%{ if machine_tuning.server_tls_bootstrap ~}
      serverTLSBootstrap: true
%{ endif ~}
